###  Specific to Project ###

# Local benchmark / backtest / analysis outputs. Per-operator state, never committed.
# No trailing slash, same reason as `.claude` below: these are SYMLINKS to the private artifacts
# repo (scripts/artifacts_link.sh), git sees a symlink as a file, and a `dir/` rule would miss it.
/benchmarks
/backtests
/research_outputs
# jscpd output dir (report/jscpd-report.json is ~2.7MB)
/report/
sandbox.py
scorecard.png
# Local-only reference trees; AGENTS.md cites them, they are not in git.
REFERENCE_COPY_OF_*

# Bot run logs. Every run_bot_on_*.yaml does `mkdir -p run_logs` and tees stdout into it
# (.github/workflows/run_bot_on_tournament.yaml:57-58); a local `make run` writes there too.
# Run logs embed full research bundles and forecaster rationales -> never commit on a public fork.
/run_logs
*.log

# Scratch, plans, audits, handoffs -- local research state, never committed.
# `scratch*/` covers both scratch/ and scratch_docs_and_planning/ in one rule.
scratch*/
# The `scratch` symlink itself, which `scratch*/` cannot match (see the /backtests note above).
/scratch
notes/
handoff-*.md
HANDOFF*.md
*.handoff.md
*.plan.md

# The launchd sync job is per-machine: launchd requires an absolute ProgramArguments path,
# which has already broken a CI test once. Only the placeholder template ships; the concrete
# plist produced by the README's sed step stays local.
scripts/research_sync/*.plist
!scripts/research_sync/*.plist.template

# Secrets. Exact-name rules used to miss backups like .env.bak, so glob then negate.
.env
.env.*
!.env.template

# Analysis dumps, jscpd reports and ablation/calibration artifacts are all JSON, so this
# blanket ignore is deliberate belt-and-suspenders on top of the directory rules above.
# FOOTGUN: it matches at ANY depth. Every JSON that MUST ship needs an explicit negation
# here. The negation is recursive on purpose -- the old `!tests/data/*.json` was one level
# deep, so tests/data/<subdir>/*.json and tests/fixtures/*.json were silently dropped.
# The fixtures are real captured venue payloads that the parsers' field-name contract is
# pinned against; without the negation they exist locally, are absent on a fresh checkout,
# the fixture-backed tests never run in CI, and the suite is green on the developer's
# machine by construction (the local-green-proves-nothing trap in AGENTS.md).
# NOTE: tests/data/performance_comments_mini.jsonl escapes this by extension. If anyone
# ever adds `*.jsonl`, add `!tests/data/**/*.jsonl` in the SAME edit.
# NOTE: dropping the blanket `*.json` means re-adding `gha-creds-*.json` in the same edit,
# since that name guards a credentials file.
*.json
!tests/data/**/*.json
# The residual round's curated correlation-cluster tables: package data, not an analysis dump.
!metaculus_bot/performance_analysis/cluster_tables.json

# Merge / rebase leftovers
*.orig
*.rej

# Agent tooling: steering files and caches. The reference AGENTS.md stays TRACKED.
# `.claude` has no trailing slash on purpose -- catches both file and directory forms.
# CLAUDE.md is a symlink to the tracked AGENTS.md, so ignoring it hides the node, not the
# content: treat AGENTS.md as fully published.
.claude
.roo/
.cursor*
.gemini/
.serena/
.desloppify/
.pre-commit-cache/
GEMINI.md*
CLAUDE.md
*Zone.Identifier

# macOS
.DS_Store
._*

# JS tooling (gemini-cli / npx can drop this)
node_modules/

# uv writes this on `uv python pin`; requires-python in pyproject.toml is the source of truth.
.python-version


### General gitignore ###

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
# Anchored to the repo root: unanchored, these match inside the flat-layout package
# (metaculus_bot/lib/, .../var/), and core.ignoreCase differs between macOS and Linux CI.
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
/MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
/target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
#Pipfile.lock

# pdm
#   Similar to Pipfile.lock, it is generally recommended to include pdm.lock in version control.
#pdm.lock
#   pdm stores project-wide configurations in .pdm.toml, but it is recommended to not include it
#   in version control.
#   https://pdm.fming.dev/#use-with-ide
.pdm.toml

# PEP 582; used by e.g. github.com/David-OConnor/pyflow and github.com/pdm-project/pdm
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
/.venv/
/env/
/venv/
/ENV/
/env.bak/
/venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# Ruff
.ruff_cache/

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
# .idea/

backtests.pre_link/
benchmarks.pre_link/

